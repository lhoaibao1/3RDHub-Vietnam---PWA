{
  "expo": {
    "name": "3RDHub Vietnam",
    "slug": "3rdhub-vietnam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.threerdhub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "threerdhub",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B2A6F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép 3RDHub Vietnam truy cập ảnh để bạn đổi ảnh đại diện.",
          "cameraPermission": "Cho phép 3RDHub Vietnam dùng camera để chụp ảnh đại diện."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://app.3rdvn.io.vn",
      "eas": {
        "projectId": "0e659853-5785-40fb-b2c3-e27a66165604"
      }
    },
    "owner": "rdhubvietnam.tech",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e659853-5785-40fb-b2c3-e27a66165604"
    },
    "platforms": [
      "ios"
    ]
  }
}